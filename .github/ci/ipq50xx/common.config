# Shared part of the CI image config for qualcommax/ipq50xx (both memory groups).
# Seeded from the diffconfig of the validated image; nss-tools-dwmac pulls in the NSS stack.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_MULTI_PROFILE=y
# without it DEVICE_PACKAGES of the individual boards are lost in a multi-device image
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# NSS runtime and the dsa plane (kmod-qca-dwmac-nss, -drv, -ecm, -vlan-mgr, qca8337-nss, qca-dsa-nss)
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# ath11k with the NSS patches (Wi-Fi offload)
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_PACKAGE_ATH_DEBUG=y

# SQM in the NSS firmware (sqm-scripts-nss: nss-edma.qos; shaper, IGS, tc with the NSS qdiscs).
# In the image, switched off: /etc/config/sqm ships with its queue disabled.
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y

# what bug reports ask for
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_dumpimage=y

# build metadata and CI
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-nss-edma"
CONFIG_KERNEL_BUILD_USER="kuncy7"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y
# CONFIG_KERNEL_DEBUG_INFO is not set


# Userland package set (both routers: linksys_spnmx56 & linksys_mx2000)
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_umdns=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_luci-app-nss=y

# Pruned defaults (IPv6 off, hardware RNG, UBIFS only, wpad-openssl replaces wpad-basic-mbedtls)
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_urandom-seed is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_losetup is not set

# USB modules out of image (=m keeps kmods-extra USB modules buildable in repo)
CONFIG_PACKAGE_kmod-usb3=m
CONFIG_PACKAGE_kmod-usb-xhci-hcd=m
CONFIG_PACKAGE_kmod-usb-dwc3=m
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=m
CONFIG_PACKAGE_kmod-usb-roles=m
CONFIG_PACKAGE_kmod-usb-core=m
CONFIG_PACKAGE_kmod-usb-common=m
