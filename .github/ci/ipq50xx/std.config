# Group "std": boards with 512 MB or 1 GB of RAM. ath11k picks its host memory profile at run
# time from the RAM size (1G here); qca-nss-drv is built MEDIUM (README.ipq50xx.md, "Memory profiles").
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# 802.11s mesh offloaded to NSS (std only: an active mesh costs RAM the 256 MB boards cannot
# spare). An encrypted mesh needs wpad-mesh-mbedtls; the image carries it.
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_mx2000=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_linksys_spnmx56=y
